    <!-- prevent forms from being submitted twice -->
    <script type="text/javascript">
      $j(function() {
        // Delegated on document so this runs after any handler bound to the
        // form itself, and so it also covers forms added to the page later.
        $j(document).on('submit', 'form', function(event) {
          var form = this;
          if (form.method.toLowerCase() !== 'post') return;
          // Another handler (AJAX, a confirm(), a knockout binding) has taken
          // over, so it owns the form from here.
          if (event.isDefaultPrevented() ||
              (event.originalEvent && event.originalEvent.defaultPrevented)) return;
          // Forms that open a new tab or return a file never navigate away,
          // so locking them would leave them locked.
          if (form.target) return;
          // Already on its way; drop the repeat.
          if ($j.data(form, 'espSubmitting')) {
            event.preventDefault();
            return;
          }
          // csrf_init.js binds this too, but only once csrf_check.js has
          // finished loading asynchronously.
          if (typeof check_csrf_cookie === 'function' && !check_csrf_cookie(form)) {
            event.preventDefault();
            return;
          }
          $j.data(form, 'espSubmitting', true);
          // Mark the button rather than disabling it: disabled controls are
          // left out of the POST data, which the browser builds after this
          // handler returns. event.submitter is unsupported on older browsers,
          // in which case mark every submit button in the form.
          var submitter = event.originalEvent && event.originalEvent.submitter;
          $j(submitter || $j(form).find(':submit'))
            .addClass('esp-submitting').attr('aria-disabled', 'true');
        });

        // Browsers can restore a page, and its locked forms, on Back.
        $j(window).on('pageshow', function() {
          $j('form').each(function() { $j.removeData(this, 'espSubmitting'); });
          $j('.esp-submitting').removeClass('esp-submitting').removeAttr('aria-disabled');
        });
      });
    </script>

    <script type="text/javascript" src="/media/scripts/json2.js"></script>
    <script type="text/javascript" src="/media/scripts/qsd.js"></script>
