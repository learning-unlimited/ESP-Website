    <meta property="og:description" content="{% block og_description %}{% if theme and theme.full_group_name %}Learn more about {{ theme.full_group_name }} at {{ settings.INSTITUTION_NAME }} {{ settings.ORGANIZATION_SHORT_NAME }}.{% else %}Learn more about {{ settings.INSTITUTION_NAME }} {{ settings.ORGANIZATION_SHORT_NAME }}.{% endif %}{% endblock %}" />
    <meta property="og:url" content="{{ request.build_absolute_uri }}" />
