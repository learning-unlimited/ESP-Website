#!/bin/bash -e

# http://stackoverflow.com/a/4774063
pushd "$(dirname "$0")" > /dev/null
SCRIPTDIR="$(pwd -P)"
popd > /dev/null

BASEDIR="$(dirname "$SCRIPTDIR")"

echo "Running lint checks..."

# Check everything except the codes listed below.
# Excluded codes are pure style with no bug-finding value, or are structural
# patterns used intentionally throughout the codebase.
#
# Style/formatting (no bug value):
#   E1xx (except E101): indentation style (continuation lines, over-indented, etc.)
#   E201,E202,E203: whitespace inside brackets
#   E221,E222: alignment spaces around operators
#   E225,E227,E228: missing whitespace around operators
#   E231: missing whitespace after ','
#   E251: spaces around keyword/default argument '='
#   E261,E262,E265,E266: comment formatting
#   E271,E272,E275: whitespace around keywords
#   E301,E302,E303,E304,E305,E306: blank line counts
#   E401: multiple imports on one line
#   E402: module-level import not at top of file
#   E501: line too long
#   E502: redundant backslash
#   E701: multiple statements on one line (colon)
#   E703: statement ends with semicolon
#   E731: lambda assignment (use def instead)
#   E741: ambiguous variable name (l, O, I)
#   W391: blank line at end of file
# Structural (intentional patterns):
#   F403: 'from module import *' — used in settings.py, models/__init__.py, etc.
#   F405: name may come from star import — consequence of F403 patterns above
# Too noisy to enforce without a dedicated cleanup pass:
#   E722: bare except
#   F401: imported but unused
#   F841: local variable assigned but never used
#
# Ignore /env (virtualenv) and .git for speed.
flake8 --extend-ignore "E111,E114,E116,E117,E122,E124,E125,E127,E128,E129,E131,E201,E202,E203,E221,E222,E225,E227,E228,E231,E251,E261,E262,E265,E266,E271,E272,E275,E301,E302,E303,E304,E305,E306,E401,E402,E501,E502,E701,E703,E731,E741,E722,F401,F403,F405,F841,W391" "$BASEDIR" --exclude=.git,env

# Those escape codes the cursor up a line and forward 22 columns (past
# "Running lint checks...").  We can't just `echo -n` above, because if there
# is lint output we want it on its own line(s).  We only get here if there are
# no errors.
echo -e "\033[1A\033[22C success!"
