#!/bin/bash
set -euf -o pipefail

if [ "$CI_JOB" = "test" ]; then
    cd esp
    ./manage.py collectstatic --noinput -v 0
    # TEST_SPLITS/TEST_GROUP shard the suite across parallel CI jobs via
    # pytest-split, which reads esp/.test_durations to balance them by time.
    # Both must be specified.
    if [ -n "${TEST_SPLITS:-}" ] && [ -z "${TEST_GROUP:-}" ]; then
        echo "TEST_SPLITS is set to '$TEST_SPLITS' but TEST_GROUP is empty or unset." >&2
        echo "Both are required to run one shard; see the shard matrix in .github/workflows/tests.yml." >&2
        exit 1
    fi
    if [ -z "${TEST_SPLITS:-}" ] && [ -n "${TEST_GROUP:-}" ]; then
        echo "TEST_GROUP is set to '$TEST_GROUP' but TEST_SPLITS is empty or unset." >&2
        echo "Both are required to run one shard; see the shard matrix in .github/workflows/tests.yml." >&2
        exit 1
    fi
    if [ -n "${TEST_SPLITS:-}" ]; then
        pytest -n auto --splits "$TEST_SPLITS" --group "$TEST_GROUP" --cov=. --cov-report=xml
    else
        pytest -n auto --cov=. --cov-report=xml
    fi
elif [ "$CI_JOB" = "lint" ]; then
    deploy/lint
else
    echo "Unknown CI_JOB: $CI_JOB"
    exit 1
fi
