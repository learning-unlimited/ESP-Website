[Unit]
Description=ESP Website Gunicorn
After=network.target postgresql.service memcached.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/esp/esp
ExecStart=/esp/env/bin/gunicorn \
    esp.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 24 \
    --timeout 900 \
    --limit-request-line 8190 \
    --limit-request-field_size 16380 \
    --capture-output \
    --access-logfile /var/log/gunicorn/esp-access.log \
    --error-logfile /var/log/gunicorn/esp-error.log
Restart=on-failure

[Install]
WantedBy=multi-user.target
